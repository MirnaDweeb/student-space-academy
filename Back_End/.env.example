PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/egsa_academy
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# SMTP Configuration (Supports Gmail SMTP via App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Egyptian Space Agency - Space Academy <your-sender-email@gmail.com>"

# Egyptian Payment Gateway Configuration (Paymob Accept / DEVELOPMENT_MOCK)
PAYMENT_PROVIDER=DEVELOPMENT_MOCK
PAYMOB_API_KEY=paymob_api_key_placeholder
PAYMOB_INTEGRATION_ID=paymob_card_integration_id_placeholder
PAYMOB_IFRAME_ID=paymob_iframe_id_placeholder
PAYMOB_HMAC_SECRET=paymob_hmac_secret_placeholder
PAYMOB_BASE_URL=https://accept.paymob.com/api

# Refund Data AES-256-GCM Encryption Key (Required for bank detail encryption at rest)
REFUND_DATA_ENCRYPTION_KEY=replace_with_a_secure_32_byte_hex_or_random_key
