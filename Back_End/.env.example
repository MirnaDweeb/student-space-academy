PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/egsa_academy
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# SMTP Configuration (Supports Gmail SMTP via App Password)
# NOTE: For Gmail, SMTP_PASS must be a 16-character Google App Password (not your Gmail login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-email@gmail.com
SMTP_PASS=your-16-character-app-password
# SMTP_PASSWORD is also supported as an alias for SMTP_PASS
SMTP_FROM="Egyptian Space Agency - Space Academy <your-sender-email@gmail.com>"

# Payment Gateway Configuration (STRIPE / DEVELOPMENT_MOCK)
PAYMENT_PROVIDER=DEVELOPMENT_MOCK
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
